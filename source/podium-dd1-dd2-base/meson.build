if base_is_dspic
  device_pack = subproject('dspic33e-device-pack')
  device_pack_path = device_pack.get_variable('device_pack_path')
  device = '-mcpu=33EP512MU810'
  pack = '-mdfp=' + device_pack_path
  common_device_args = [device, pack, '-mlarge-code', '-mlarge-aggregate']
  warning_args = [
    '-Wall',
    '-Wextra',
    '-Werror',
    '-Wno-missing-braces',
    '-Wno-missing-field-initializers',
    '-mno-eds-warn',
  ]
  firmware_c_args = common_device_args + warning_args + [
    '-c',
    '-mtext=application',
    '-ffunction-sections',
    '-DNDEBUG',
  ]
  firmware_linker_script = files('source/platform/dspic33e/p33EP512MU810.gld')[0]
  firmware = executable(
    'firmware',
    base_sources,
    build_by_default: false,
    c_args: firmware_c_args,
    include_directories: [base_include, base_common_include],
    link_args: common_device_args + [
      '-mtext=application',
      '-Wl,--gc-sections',
      '-Wl,--script=' + firmware_linker_script.full_path(),
    ],
    link_depends: firmware_linker_script,
    name_suffix: 'elf',
    override_options: ['warning_level=0', 'werror=false'],
    build_subdir: 'package.p',
  )

  base_python = import('python').find_installation()
  bin2hex = find_program('xc16-bin2hex')
  base_hex = custom_target(
    'podium-dd1-dd2-base-intel-hex',
    input: firmware,
    output: 'firmware.hex',
    command: [bin2hex, '@INPUT@'],
    build_subdir: 'package.p',
  )
  base_package_header = '0x0706_V3_9_1_1_release_rev2668f65a'
  firmware_packages += [
    {
      'target': 'podium-dd1-dd2-base-hex',
      'input': base_hex,
      'output': 'podium-dd1-dd2-base.hex',
      'python': base_python,
      'encrypt_args': ['--header', base_package_header],
      'verify_args': ['--header', base_package_header],
      'dependencies': files('../../tools/crypto.py'),
      'test': 'base-encryption',
      'suite': ['base', 'package'],
    },
  ]

  simulator = subproject('dspic33e-sim', native: true)
  base_simulator_runner = simulator.get_variable('dspic33ep_mu_firmware_runner')
  test_linker_script = device_pack_path / 'support/dsPIC33E/gld/p33EP512MU810.gld'
  base_test_c_args = common_device_args + [
    '-mno-eds-warn',
    '-c',
    '-mconst-in-data',
    '-DOPENTEC_SIMULATOR_TEST',
  ]
  base_test_link_args = common_device_args + ['-Wl,--script=' + test_linker_script]

  test(
    'base-firmware',
    base_simulator_runner,
    args: [
      firmware.full_path(),
      '--reset-address',
      '__reset',
      '--max-instructions',
      '1000000',
      '--max-cycles',
      '10000000',
      '--expect-instruction-limit',
      '--coverage',
    ],
    depends: firmware,
    suite: ['base', 'firmware'],
    timeout: 120,
  )
endif

if not meson.is_cross_build() or base_is_dspic
  subdir('tests')
endif
