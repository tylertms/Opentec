base_test_python = import('python').find_installation()
test(
  'base-startup-power-service-scope',
  base_test_python,
  args: [files('source/startup_power_service_scope.py')],
  suite: ['base', 'firmware'],
)

if base_is_dspic
  base_tests += {
    'platform-aux-bus': [
      'source/platform_aux_bus.c',
      'platform/dspic33e/aux_bus.c',
      'platform/dspic33e/time.c',
    ],
    'platform-power': ['source/platform_power.c', 'platform/dspic33e/power.c'],
    'platform-pedal-link': [
      'source/platform_pedal_link.c',
      'platform/dspic33e/pedal_link.c',
    ],
    'platform-motor-link': [
      'source/platform_motor_link.c',
      'platform/dspic33e/motor_link.c',
    ],
    'platform-serial-link': [
      'source/platform_serial_link.c',
      'platform/dspic33e/serial_link.c',
    ],
    'platform-usb': [
      'source/platform_usb.c',
      'platform/dspic33e/usb.c',
      'usb/buffer_descriptor.c',
    ],
    'platform-force-feedback-timer': [
      'source/platform_force_feedback_timer.c',
      'platform/dspic33e/force_feedback_timer.c',
    ],
  }
endif

foreach name, source_names : base_tests
  test_sources = []
  foreach source_index : range(1, source_names.length())
    test_sources += files('../source/' + source_names[source_index])
  endforeach

  image = executable(
    'base-' + name + '-test',
    source_names[0],
    test_sources,
    build_by_default: false,
    c_args: base_test_c_args,
    include_directories: base_include,
    link_args: base_test_link_args,
    override_options: ['warning_level=0', 'werror=false'],
  )

  if base_is_dspic
    if name == 'settings-journal'
      instruction_limit = '70000000'
      test_timeout = 1800
    elif name == 'usb-device'
      instruction_limit = '6000000'
      test_timeout = 180
    else
      instruction_limit = '3000000'
      test_timeout = 120
    endif
    test(
      'base-' + name,
      base_simulator_runner,
      args: [
        image.full_path(),
        '--reset-address',
        '__reset',
        '--stop-address',
        '0x238',
        '--fail-address',
        '___assert_fail',
        '--fail-address',
        '_abort',
        '--max-instructions',
        instruction_limit,
        '--max-cycles',
        '0',
        '--coverage',
      ],
      depends: image,
      timeout: test_timeout,
      suite: 'base',
    )
  else
    test('base-' + name, image, suite: 'base')
  endif
endforeach
